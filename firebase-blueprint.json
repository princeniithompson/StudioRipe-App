{
  "entities": {
    "UserConfig": {
      "title": "User Configurations",
      "description": "User specific app configuration like accent colors and zoom.",
      "type": "object",
      "properties": {
        "activeAccent": { "type": "string" },
        "fontScale": { "type": "number" },
        "agentSettings": { "type": "object" },
        "createdAt": { "type": "number" }
      }
    },
    "Project": {
      "title": "Project",
      "description": "A user's storyboard project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "updatedAt": { "type": "number" },
        "userId": { "type": "string" },
        "assets": { "type": "array" },
        "agentMessages": { "type": "array" }
      },
      "required": ["id", "title", "updatedAt", "userId", "assets"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserConfig" },
      "description": "User settings document."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User project document."
    }
  }
}
